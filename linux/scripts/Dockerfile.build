FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive TZ=Asia/Shanghai PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates binutils tzdata && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/buildenv
COPY requirements.txt requirements-build.txt /tmp/requirements/
RUN /opt/buildenv/bin/pip install --no-cache-dir -r /tmp/requirements/requirements-build.txt
ENV PATH=/opt/buildenv/bin:$PATH
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends libpython3.12 && rm -rf /var/lib/apt/lists/*
